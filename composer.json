{
    "name": "seeware/sw-auth",
    "version": "1.0.0",
    "description": "Módulo de autenticação e autorização - RBAC, MFA, sessões, reset de password",
    "type": "library",
    "license": "proprietary",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv":"^5.6" ,
        "spomky-labs/otphp": "^11.3",
        "phpmailer/phpmailer": "^6.9",
        "respect/validation":"^2.3",
        "monolog/monolog":"^3.7",
        "endroid/qr-code": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "SwAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SwAuth\\Tests\\": "tests/"
        }
    }
}